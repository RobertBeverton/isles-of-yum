---
layout: base.njk
title: Library
---
<section class="hero">
  <h1 class="display">Isles of Yum <span class="accent">— the hungriest adventures.</span></h1>
</section>

<input type="search" id="search-box" placeholder="Search Isles of Yum..." aria-label="Search stories">

<section id="continue-section" aria-labelledby="continue-heading" hidden>
  <h2 id="continue-heading">Continue</h2>
  <div class="card-row" id="continue-row"></div>
</section>

<div id="stories">
{% if stories.seriesGroups.length > 0 %}
<section aria-labelledby="arcs-heading">
  <h2 id="arcs-heading" class="visually-hidden">Story arcs</h2>
  <div class="arc-card-list">
    {% for group in stories.seriesGroups %}
      {% include "arc-card.njk" %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if stories.standalone.length > 0 %}
<section aria-labelledby="standalone-heading" class="series-row-section series-row-section-neutral">
  <div class="series-row-heading">
    <h2 id="standalone-heading">More Stories</h2>
  </div>
  <div class="card-row">
    {% for story in stories.standalone %}
      {% include "story-card.njk" %}
    {% endfor %}
  </div>
</section>
{% endif %}
</div>

<script src="{{ '/assets/search.js' | url }}"></script>
<script src="{{ '/assets/mini-player.js' | url }}" type="module"></script>
<script src="{{ '/assets/library.js' | url }}"></script>
<script src="{{ '/assets/play-button.js' | url }}"></script>
