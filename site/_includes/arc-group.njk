<div class="rail-group-icon-cell{% if not loop.first %} rail-group-break{% endif %}">
  <svg class="rail-group-icon" viewBox="0 0 120 82" aria-hidden="true" style="--accent-bg: {{ group.accentColor.background }}; --accent-text: {{ group.accentColor.text }};">
    <path class="icon-main" d="{{ icons.path(group.stories[0].icon) }}" />
  </svg>
</div>
<div class="rail-group-content{% if not loop.first %} rail-group-break{% endif %}" style="--accent-bg: {{ group.accentColor.background }};">
  {% if group.series %}
  <h3 class="rail-group-heading">{{ group.series }}</h3>
  {% endif %}
  <div class="rail-group-rows">
    {% for story in group.stories %}
    <div class="story-row" data-title="{{ story.title }}" data-tags="{{ story.tags | join(' ') }}" data-description="{{ story.description }}">
      <a class="story-row-link" href="{{ story.url }}">{{ story.title }}</a>
      {% if story.audioUrl %}
      <button type="button" class="play-button-primary" data-play-slug="{{ story.slug }}" data-play-url="{{ story.audioUrl }}" data-play-title="{{ story.title }}" data-play-story-url="{{ story.url }}" aria-label="Begin {{ story.title }}">Begin</button>
      {% else %}
      <a class="play-button-primary" href="{{ story.url }}" aria-label="Begin {{ story.title }}">Begin</a>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
