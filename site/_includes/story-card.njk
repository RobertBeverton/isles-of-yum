<div class="story-card" data-title="{{ story.title }}" data-tags="{{ story.tags | join(' ') }}" data-description="{{ story.description }}" data-slug="{{ story.slug }}" style="--accent-bg: {{ story.accentColor.background if story.accentColor else '#6b7280' }};">
  <a class="story-card-link" href="{{ story.url }}">
    <svg class="story-card-wave" viewBox="0 0 320 90" preserveAspectRatio="none" aria-hidden="true">
      <path class="wave-fill" d="M0 70 C 60 40, 100 90, 160 60 S 260 20, 320 50 L 320 90 L 0 90 Z" />
    </svg>
    <svg class="story-icon" viewBox="0 0 120 82" aria-hidden="true">
      <path class="icon-main" d="{{ icons.path(story.icon) }}" />
    </svg>
    <div class="story-card-text">
      <h3>{{ story.title }}</h3>
      <p class="card-meta">~{{ story.readMinutes }} min read{% if story.audioMinutes %} · ~{{ story.audioMinutes }} min listen{% endif %}</p>
    </div>
  </a>
  <div class="story-card-actions">
    {% if story.audioUrl %}
    <button type="button" class="play-button-primary" data-play-slug="{{ story.slug }}" data-play-url="{{ story.audioUrl }}" data-play-title="{{ story.title }}" data-play-story-url="{{ story.url }}" aria-label="Listen to {{ story.title }}"><span aria-hidden="true">▶︎</span> Listen</button>
    <a class="read-link" href="{{ story.url }}">Read →</a>
    {% else %}
    <a class="read-link read-link-primary" href="{{ story.url }}">Read story →</a>
    <span class="no-audio-badge" role="img" aria-label="Text only, no audio">🚫🔊</span>
    {% endif %}
  </div>
</div>
